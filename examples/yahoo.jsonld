{
  "@context": {
    "dash": "https://solid-apps.github.io/dash/ns#"
  },
  "@type": "dash:Board",
  "theme": "light",
  "accent": "#7c3aed",
  "layout": "auto",
  "background": {
    "preset": "paper"
