{
  "@context": {
    "dash": "https://solid-apps.github.io/dash/ns#"
  },
  "@type": "dash:Board",
  "theme": "auto",
  "accent": "#0ea5e9",
  "layout": "auto",
  "background": null,
  "title": "NAS",
  "search": "duckduckgo",
  "groups": [
    {
      "name": "Files",
      "columns": 1,
      "services": [
        {
          "name": "Nextcloud",
          "href": "https://nextcloud.com",
          "subtitle": "Cloud storage",
          "icon": "di:nextcloud"
        },
        {
          "name": "Synology",
          "href": "https://synology.com",
          "subtitle": "DSM",
          "icon": "di:synology"
        },
        {
          "name": "TrueNAS",
          "href": "https://truenas.com",
          "subtitle": "ZFS storage",
          "icon": "di:truenas"
        }
      ]
    },
    {
      "name": "Photos",
      "columns": 1,
      "services": [
        {
          "name": "Immich",
          "href": "https://immich.app",
          "subtitle": "Photo backup",
          "icon": "di:immich"
        },
        {
          "name": "PhotoPrism",
          "href": "https://photoprism.app",
          "subtitle": "Photo library",
          "icon": "di:photoprism"
        }
      ]
    },
    {
      "name": "Sync & Backup",
      "columns": 2,
      "services": [
        {
          "name": "Syncthing",
          "href": "https://syncthing.net",
          "subtitle": "File sync",
          "icon": "di:syncthing"
        },
        {
          "name": "Duplicati",
          "href": "https://duplicati.com",
          "subtitle": "Backups",
          "icon": "di:duplicati"
        },
        {
          "name": "Kopia",
          "href": "https://kopia.io",
          "subtitle": "Snapshots",
          "icon": "di:kopia"
        },
        {
          "name": "Restic",
          "href": "https://restic.net",
          "subtitle": "Backup",
          "icon": "🧷"
        }
      ]
    },
    {
      "name": "Documents",
      "columns": 2,
      "services": [
        {
          "name": "Paperless-ngx",
          "href": "https://docs.paperless-ngx.com",
          "subtitle": "Documents",
          "icon": "di:paperless-ngx"
        },
        {
          "name": "Stirling PDF",
          "href": "https://stirlingpdf.com",
          "subtitle": "PDF tools",
          "icon": "di:stirling-pdf"
        }
      ]
    }
  ],
  "bookmarks": []
}
