{
  "@context": {
    "dash": "https://solid-apps.github.io/dash/ns#"
  },
  "@type": "dash:Board",
  "theme": "auto",
  "accent": "#ec4899",
  "layout": "auto",
  "background": {
    "preset": "accent"
  },
  "title": "Home",
  "search": "duckduckgo",
  "groups": [
    {
      "name": "Watch & Listen",
      "columns": 1,
      "services": [
        {
          "name": "Jellyfin",
          "href": "https://jellyfin.org",
          "subtitle": "Movies & TV",
          "icon": "di:jellyfin"
        },
        {
          "name": "Audiobookshelf",
          "href": "https://audiobookshelf.org",
          "subtitle": "Audiobooks",
          "icon": "di:audiobookshelf"
        },
        {
          "name": "Kavita",
          "href": "https://kavitareader.com",
          "subtitle": "Comics & books",
          "icon": "di:kavita"
        }
      ]
    },
    {
      "name": "Photos",
      "columns": 1,
      "services": [
        {
          "name": "Immich",
          "href": "https://immich.app",
          "subtitle": "Family photos",
          "icon": "di:immich"
        }
      ]
    },
    {
      "name": "Kitchen & Lists",
      "columns": 2,
      "services": [
        {
          "name": "Mealie",
          "href": "https://mealie.io",
          "subtitle": "Recipes",
          "icon": "di:mealie"
        },
        {
          "name": "Tandoor",
          "href": "https://tandoor.dev",
          "subtitle": "Meal planning",
          "icon": "👨‍🍳"
        },
        {
          "name": "Grocy",
          "href": "https://grocy.info",
          "subtitle": "Groceries",
          "icon": "di:grocy"
        },
        {
          "name": "Nextcloud",
          "href": "https://nextcloud.com",
          "subtitle": "Calendar & files",
          "icon": "di:nextcloud"
        }
      ]
    },
    {
      "name": "Home",
      "columns": 2,
      "services": [
        {
          "name": "Home Assistant",
          "href": "https://home-assistant.io",
          "subtitle": "Smart home",
          "icon": "di:home-assistant"
        },
        {
          "name": "Vaultwarden",
          "href": "https://github.com/dani-garcia/vaultwarden",
          "subtitle": "Family passwords",
          "icon": "di:vaultwarden"
        }
      ]
    }
  ],
  "bookmarks": [
    {
      "name": "Household",
      "links": [
        {
          "name": "Weather",
          "href": "https://weather.com"
        },
        {
          "name": "School",
