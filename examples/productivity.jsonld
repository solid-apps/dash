{
  "@context": {
    "dash": "https://solid-apps.github.io/dash/ns#"
  },
  "@type": "dash:Board",
  "theme": "auto",
  "accent": "#14b8a6",
  "layout": "auto",
  "background": {
    "preset": "accent"
  },
  "title": "Productivity",
  "search": "duckduckgo",
  "groups": [
    {
      "name": "Cloud",
      "columns": 2,
      "services": [
        {
          "name": "Nextcloud",
          "href": "https://nextcloud.com",
          "subtitle": "Files & office",
          "icon": "di:nextcloud"
        },
        {
          "name": "Immich",
          "href": "https://immich.app",
          "subtitle": "Photos",
          "icon": "di:immich"
        }
      ]
    },
    {
      "name": "Tasks",
      "columns": 1,
      "services": [
        {
          "name": "Vikunja",
          "href": "https://vikunja.io",
          "subtitle": "To-do & lists",
          "icon": "di:vikunja"
        },
        {
          "name": "Planka",
          "href": "https://planka.app",
          "subtitle": "Kanban",
          "icon": "di:planka"
        },
        {
          "name": "Focalboard",
          "href": "https://focalboard.com",
          "subtitle": "Project boards",
          "icon": "di:focalboard"
        }
      ]
    },
    {
      "name": "Notes & Docs",
      "columns": 1,
      "services": [
        {
          "name": "Outline",
          "href": "https://getoutline.com",
          "subtitle": "Wiki",
          "icon": "di:outline"
        },
        {
          "name": "Trilium",
          "href": "https://github.com/zadam/trilium",
          "subtitle": "Notes",
          "icon": "di:trilium"
        },
        {
          "name": "Paperless-ngx",
          "href": "https://docs.paperless-ngx.com",
          "subtitle": "Documents",
          "icon": "di:paperless-ngx"
        }
      ]
    },
    {
      "name": "Utilities",
      "columns": 2,
      "services": [
        {
          "name": "Vaultwarden",
          "href": "https://github.com/dani-garcia/vaultwarden",
          "subtitle": "Passwords",
          "icon": "di:vaultwarden"
        },
        {
          "name": "FreshRSS",
          "href": "https://freshrss.org",
          "subtitle": "RSS reader",
          "icon": "di:freshrss"
        },
        {
          "name": "Wallabag",
          "href": "https://wallabag.org",
          "subtitle": "Read later",
          "icon": "di:wallabag"
        },
        {
          "name": "Mealie",
          "href": "https://mealie.io",
          "subtitle": "Recipes",
          "icon": "di:mealie"
        }
      ]
    }
  ],
  "bookmarks": []
}
